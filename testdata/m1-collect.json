{
  "schema_version": "v2.0",
  "rules": [
    {
      "id": "M1-PRIVESC-SETUID",
      "description": "M1 smoke: setuid() privilege change observed",
      "category": "process",
      "severity": "high",
      "decision": "alert",
      "action": "log",
      "when": { "op": "eq", "field": "privtype", "value": "setuid" }
    },
    {
      "id": "M1-INOTIFY-CREATE",
      "description": "M1 smoke: file created under the watched directory",
      "category": "file",
      "severity": "medium",
      "decision": "alert",
      "action": "log",
      "when": {
        "op": "and",
        "args": [
          { "op": "eq", "field": "file_op", "value": "create" },
          { "op": "starts_with", "field": "file_path", "value": "/tmp/edr-collect/" }
        ]
      }
    },
    {
      "id": "M1-BPFOP",
      "description": "M1 smoke: any bpf() syscall",
      "category": "rootkit",
      "severity": "high",
      "decision": "alert",
      "action": "log",
      "when": { "op": "ge", "field": "bpf_cmd", "value": "0" }
    }
  ]
}
