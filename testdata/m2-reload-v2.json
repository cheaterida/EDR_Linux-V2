{
  "schema_version": "v2.0",
  "rules": [
    {
      "id": "M2-RELOAD-WHOAMI",
      "description": "M2 smoke: added on hot-reload to prove the swap took effect",
      "category": "process",
      "severity": "medium",
      "decision": "alert",
      "action": "log",
      "when": { "op": "eq", "field": "process_name", "value": "whoami" }
    }
  ]
}
